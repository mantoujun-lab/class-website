---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactIcon from '../components/ContactIcon.astro';

const overview = [
	{ title: '班级名称', description: '25 级计算机应用 1 班' },
	{ title: '专业方向', description: '计算机应用' },
	{ title: '班级人数', description: '37 人' },
];

const culture = [
	{
		title: '班级愿景',
		description: '团结、勤奋、创新、奉献，争做新时代中职学生。',
	},
	{
		title: '班级氛围',
		description: '同学之间团结友爱，互帮互助，课堂积极活跃，课余生活丰富多彩。',
	},
];

const daily = [
	{
		title: '学习日常',
		description: '同学们认真听讲、积极实践，在专业技能与文化课上都能保持专注。',
	},
];
---

<Layout
	title="班级介绍 - 25 级计算机应用 1 班"
	description="认识 25 级计算机应用 1 班这个集体，了解班级的组成、氛围与日常。"
>
	<Hero title="班级介绍" subtitle="认识 25 级计算机应用 1 班这个集体" />

	<main class="container mx-auto p-6 md:p-8 max-w-5xl space-y-6">
		<!-- 欢迎语 -->
		<section class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title">👋 欢迎来到 25 级计算机应用 1 班</h2>
				<p>
					欢迎来到 <strong>25 级计算机应用 1 班</strong>。我们是一支充满活力的集体，由 37 名同学组成，共同度过的校园生活。
				</p>
				<p>
					在这里，我们一起学习 <strong class="text-primary">计算机应用</strong> 的专业技能，也一起经历成长的酸甜苦辣。本页面将带你快速了解班级的基本情况、文化氛围与日常点滴。
				</p>
			</div>
		</section>

		<!-- 班级概况 -->
		<section class="space-y-3">
			<h2 class="text-2xl font-bold px-1">班级概况</h2>
			<div class="stats stats-vertical lg:stats-horizontal shadow w-full bg-base-100">
				{overview.map((item) => (
					<div class="stat">
						<div class="stat-title">{item.title}</div>
						<div class="stat-value text-primary text-lg md:text-xl break-words leading-tight">
							{item.description}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- 班级文化 -->
		<section class="space-y-3">
			<h2 class="text-2xl font-bold px-1">班级文化</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{culture.map((item) => (
					<div class="card bg-base-100 shadow-sm">
						<div class="card-body">
							<h3 class="card-title">{item.title}</h3>
							<p class="opacity-80">{item.description}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- 日常与风采 -->
		<section class="space-y-3">
			<h2 class="text-2xl font-bold px-1">日常与风采</h2>
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body">
					<h3 class="card-title">📚 {daily[0].title}</h3>
					<p class="opacity-80">{daily[0].description}</p>
				</div>
			</div>
		</section>

		<!-- 持续完善 CTA -->
		<section class="card bg-base-100 shadow-sm border border-base-300">
			<div class="card-body items-center text-center">
				<h2 class="card-title">✨ 持续完善中</h2>
				<p class="opacity-80 max-w-xl">
					更多内容持续完善中，如果你愿意为班级介绍补充信息，欢迎通过 GitHub Issue 告诉我们。
				</p>
				<div class="card-actions mt-2">
					<a
						class="btn btn-primary btn-sm"
						href="https://github.com/mantoujun-lab/class-website/issues"
						target="_blank"
						rel="noopener noreferrer"
					>
						<ContactIcon kind="github" />
						提交 Issue
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
