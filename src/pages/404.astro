---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - 页面走丢啦" description="你访问的页面不存在或已被移除。回到首页继续逛逛吧！" noindex>
	<main class="hero bg-base-200 min-h-[calc(100vh-12rem)]">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="mb-2 bg-linear-to-br from-primary to-secondary bg-clip-text text-[8rem] font-black leading-none text-transparent sm:text-[10rem]">
					404
				</h1>

				<h2 class="mb-2 text-2xl font-bold sm:text-3xl">哎呀，页面走丢啦！</h2>
				<p class="mb-8 opacity-70">它可能已经毕业离校，或者地址抄错了。</p>

				<div class="flex flex-col justify-center gap-3 sm:flex-row">
					<a href="/" class="btn btn-primary">回到首页</a>
					<button type="button" id="go-back" class="btn btn-ghost">返回上一页</button>
				</div>
			</div>
		</div>
	</main>

	<script is:inline>
		const backBtn = document.getElementById('go-back');
		backBtn?.addEventListener('click', () => {
			// history.length counts the whole session stack, so `> 1` doesn't
			// guarantee the previous page is on this site (e.g. arrived from an
			// external search engine). Accepting that as a trade-off.
			if (window.history.length > 1) {
				window.history.back();
			} else {
				window.location.href = '/';
			}
		});
	</script>
</Layout>
