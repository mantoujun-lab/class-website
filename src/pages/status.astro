---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout
	title="班级状态 - 25 级计算机应用 1 班"
	description="25 级计算机应用 1 班的班级公告、活动安排与近况动态，按时间倒序排列。"
>
	<Hero title="班级状态" subtitle="班级公告、安排与近况。" />
	<main class="container mx-auto p-8 max-w-2xl">
		<!-- Single-column card list -->
		<div id="status-list" class="flex flex-col gap-4" aria-busy="true">
			<!-- Loading skeleton -->
			<div id="status-loading" class="flex flex-col gap-4" role="status">
				<span class="sr-only">正在加载班级动态...</span>
				<div class="card bg-base-100 shadow">
					<div class="card-body animate-pulse">
						<div class="h-5 bg-base-300 rounded w-1/3"></div>
						<div class="h-4 bg-base-300 rounded w-full mt-2"></div>
						<div class="h-4 bg-base-300 rounded w-2/3 mt-1"></div>
					</div>
				</div>
				<div class="card bg-base-100 shadow">
					<div class="card-body animate-pulse">
						<div class="h-5 bg-base-300 rounded w-1/4"></div>
						<div class="h-4 bg-base-300 rounded w-full mt-2"></div>
					</div>
				</div>
			</div>

			<noscript>
				<style>#status-loading { display: none; }</style>
				<div class="alert alert-warning">
					<span>需要启用 JavaScript 才能加载班级动态。</span>
				</div>
			</noscript>

			<!-- Empty state -->
			<div id="status-empty" class="hidden card bg-base-100 shadow">
				<div class="card-body items-center text-center">
					<p class="opacity-60">暂无状态卡片</p>
				</div>
			</div>

			<!-- Error state -->
			<div id="status-error" class="hidden alert alert-error" role="alert">
				<span id="status-error-message">加载失败，请稍后重试</span>
				<button id="status-retry" type="button" class="btn btn-sm">重新加载</button>
			</div>
			<!-- Cards injected here -->
		</div>
	</main>
</Layout>

<script>
	interface StatusCard {
		id: string;
		title: string;
		content: string;
		time: string;
		tags: string[];
	}

	const STATUS_TIMEOUT_MS = 8000;

	function formatTime(iso: string): string {
		try {
			const date = new Date(iso);
			if (Number.isNaN(date.getTime())) return iso;

			return date.toLocaleString('zh-CN', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
			});
		} catch {
			return iso;
		}
	}

	function escapeHtml(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}

	function getTimestamp(value: string | undefined): number {
		if (!value) return 0;

		const timestamp = Date.parse(value);
		return Number.isNaN(timestamp) ? 0 : timestamp;
	}

	function renderCard(card: StatusCard): string {
		const tags = Array.isArray(card.tags)
			? card.tags
					.map(
						(t) =>
							`<span class="badge badge-primary badge-sm">${escapeHtml(t)}</span>`
					)
					.join('')
			: '';

		return `
			<article class="card bg-base-100 shadow" data-status-card>
				<div class="card-body gap-2">
					<h3 class="card-title">${escapeHtml(card.title || '')}</h3>
					<p class="whitespace-pre-wrap break-words opacity-80">${escapeHtml(
						card.content || ''
					)}</p>
					<div class="flex flex-wrap gap-1 mt-1">${tags}</div>
					<time class="text-xs opacity-50 mt-1" datetime="${escapeHtml(
						card.time
					)}">${escapeHtml(formatTime(card.time))}</time>
				</div>
			</article>
		`;
	}

	function getErrorMessage(error: unknown): string {
		if (error instanceof DOMException && error.name === 'AbortError') {
			return '请求超时，请稍后重试';
		}

		return '加载失败，请稍后重试';
	}

	let isLoading = false;

	async function loadStatus() {
		if (isLoading) return;

		const listEl = document.getElementById('status-list')!;
		const loadingEl = document.getElementById('status-loading')!;
		const emptyEl = document.getElementById('status-empty')!;
		const errorEl = document.getElementById('status-error')!;
		const errorMessageEl = document.getElementById('status-error-message')!;
		const retryEl = document.getElementById('status-retry') as HTMLButtonElement;

		isLoading = true;
		retryEl.disabled = true;
		loadingEl.classList.remove('hidden');
		emptyEl.classList.add('hidden');
		errorEl.classList.add('hidden');
		listEl.setAttribute('aria-busy', 'true');
		listEl.querySelectorAll('[data-status-card]').forEach((card) => card.remove());

		const controller = new AbortController();
		const timeoutId = window.setTimeout(() => controller.abort(), STATUS_TIMEOUT_MS);

		try {
			const res = await fetch('/api/status', {
				cache: 'no-store',
				signal: controller.signal,
			});
			if (!res.ok) throw new Error(`HTTP ${res.status}`);

			const payload: unknown = await res.json();
			if (!Array.isArray(payload)) {
				throw new Error('Invalid status response');
			}

			const cards = payload as StatusCard[];
			loadingEl.classList.add('hidden');
			listEl.setAttribute('aria-busy', 'false');

			if (cards.length === 0) {
				emptyEl.classList.remove('hidden');
				return;
			}

			cards.sort(
				(a, b) => getTimestamp(b.time) - getTimestamp(a.time)
			);

			const fragment = document.createDocumentFragment();
			cards.forEach((card) => {
				const wrapper = document.createElement('div');
				wrapper.innerHTML = renderCard(card);
				const element = wrapper.firstElementChild;
				if (element) fragment.appendChild(element);
			});
			listEl.appendChild(fragment);
		} catch (err) {
			loadingEl.classList.add('hidden');
			errorMessageEl.textContent = getErrorMessage(err);
			errorEl.classList.remove('hidden');
			listEl.setAttribute('aria-busy', 'false');
			console.error('[status] load failed:', err);
		} finally {
			window.clearTimeout(timeoutId);
			isLoading = false;
			retryEl.disabled = false;
		}
	}

	const retryEl = document.getElementById('status-retry');
	retryEl?.addEventListener('click', loadStatus);

	loadStatus();
</script>
