---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardSection from '../components/CardSection.astro';

const cards = [
	{ title: '文档', description: '班级的文档', href: 'https://docs.hjx-25pc1.xyz', actionLabel: '跳转' },
	{ title: '博客', description: '班级的博客', href: 'https://blog.hjx-25pc1.xyz', actionLabel: '跳转' },
];
---

<Layout
	title="25 级计算机应用 1 班"
	description="海南省经济技术学校 25 级计算机应用 1 班的班级网站，记录班级点滴，留下属于我们的回忆。这里汇集了班级的文档与博客入口。"
>
	<Hero title="25 级计算机应用 1 班" subtitle="记录班级点滴，留下属于我们的回忆。" />
	<CardSection cards={cards} />
</Layout>
