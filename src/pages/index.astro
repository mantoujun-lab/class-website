				</a>
			</div>
		</div>

		<!-- Hero -->
		<section class="hero bg-base-200">
			<div class="hero-content text-center py-16">
				<div class="max-w-md">
					<h1 class="text-4xl font-bold">25 级计算机应用 1 班</h1>
					<p class="py-4 opacity-70">记录班级点滴, 留下属于我们的回忆.</p>
				</div>
			</div>
		</section>

		<!-- Cards -->
		<main class="container mx-auto p-8">
			<h2 class="text-2xl font-bold mb-6">导航</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<h3 class="card-title">占位符 1</h3>
						<p class="opacity-70">这里是动态摘要占位, 稍后替换为真实内容.</p>
						<div class="card-actions justify-end">
							<button class="btn btn-primary btn-sm">跳转</button>
						</div>
					</div>
				</div>
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<h3 class="card-title">占位符 2</h3>
						<p class="opacity-70">这里是动态摘要占位, 稍后替换为真实内容.</p>
						<div class="card-actions justify-end">
							<button class="btn btn-primary btn-sm">跳转</button>
						</div>
					</div>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="footer grid-cols-3 p-10 bg-base-200 text-base-content">
			<nav>
				<h6 class="footer-title">关于</h6>
				<a class="link link-hover">班级介绍</a>
				<a class="link link-hover">技术栈</a>
			</nav>
			<nav>
				<h6 class="footer-title">资源</h6>
				<a class="link link-hover" href="https://github.com/mantoujun-lab/class-website" target="_blank" rel="noopener noreferrer">GitHub 仓库</a>
				<a class="link link-hover">Issue 反馈</a>
			</nav>
			<nav>
				<h6 class="footer-title">支持</h6>
				<a class="link link-hover">微信赞赏</a>
			</nav>
		</footer>
		<footer class="footer px-10 py-4 border-t bg-base-200 border-base-300 text-base-content/60">
			<aside class="items-center">
				<p>© 2026 25 级计算机应用 1 班 · MIT License</p>
			</aside>
		</footer>
	<script is:inline>
		const html = document.documentElement;
		const saved = localStorage.getItem('theme');
		if (saved === 'light' || saved === 'dark') {
			html.setAttribute('data-theme', saved);
		} else if (saved === 'auto') {
			html.removeAttribute('data-theme');
		}
		document.querySelectorAll('[data-set-theme]').forEach((el) => {
			el.addEventListener('click', (e) => {
				e.preventDefault();
				const t = el.dataset.setTheme;
				if (t === 'auto') {
					html.removeAttribute('data-theme');
				} else {
					html.setAttribute('data-theme', t);
				}
				localStorage.setItem('theme', t);
			});
		});
	</script>
	</body>
</html>
