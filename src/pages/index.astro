				</a>
			</div>
			<div class="navbar-end">
				<ul class="menu menu-horizontal px-1 mr-2 hidden lg:flex">
					<li><a>首页</a></li>
					<li><a>动态</a></li>
					<li><a>关于</a></li>
				</ul>
				<div class="dropdown dropdown-end">
					<div tabindex="0" role="button" class="btn btn-ghost btn-circle" aria-label="theme">
						<svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 2a10 10 0 0 0 0 20Z" /></svg>
