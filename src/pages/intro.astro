---
import Layout from '../layouts/Layout.astro';
import ContactLink from '../components/ContactLink.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { contactLinks } from '../lib/contact-links';

// GitHub 组织信息（数据硬编码，便于静态构建，无需调用 API）
const org = {
  name: "mantoujun's Lab",
  handle: 'mantoujun-lab',
  url: contactLinks.github,
  urlorg: 'https://github.com/orgs/mantoujun-lab',
  website: 'https://mantoujun-lab.com',
  location: 'China',
  contact: contactLinks.email,
  qq: contactLinks.qq,
  gitee: contactLinks.gitee,
  discord: contactLinks.discord,
  avatar: 'https://avatars.githubusercontent.com/u/300905089?s=200&v=4',
};

const languages = ['JavaScript', 'Astro', 'Python', 'TypeScript', 'HTML'];
---

<Layout
  title="关于我们 - 25 级计算机应用 1 班"
  description="我们是 mantoujun's Lab，用最小可行方案落地每一个想法。了解 GitHub 组织 mantoujun-lab 的成员、目标、仓库与社区入口。"
>
  <main class="container mx-auto p-6 md:p-8 max-w-5xl space-y-3">
    <!-- 组织简介 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body flex-row items-center gap-6">
        <div class="avatar">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden">
            <img src={org.avatar} alt={`${org.name} avatar`} loading="lazy" decoding="async" width="200" height="200" />
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl md:text-3xl font-bold flex flex-wrap items-center gap-2">
            {org.name}
            <span class="badge badge-success badge-outline align-middle">Verified</span>
          </h1>
          <p class="text-sm opacity-60 mt-1">
            <span class="font-mono">@{org.handle}</span>
            <span class="mx-2">·</span>
            <span>{org.location}</span>
          </p>
          <p class="mt-3 text-base md:text-lg">
            用最小可行方案落地每一个想法。
          </p>
        </div>
        <div class="hidden md:flex flex-col gap-2">
          <a class="btn btn-primary btn-sm" href={org.url} target="_blank" rel="noopener noreferrer">
            <ContactIcon kind="github" />
            访问组织
          </a>
        </div>
      </div>
      <div class="card-body pt-0">
        <div class="md:hidden flex flex-wrap gap-2">
          <a class="btn btn-primary btn-sm flex-1" href={org.url} target="_blank" rel="noopener noreferrer">访问 GitHub 组织</a>
        </div>
      </div>
    </section>

    <!-- 欢迎语 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">👋 欢迎来到 mantoujun's Lab</h2>
        <p>
          你好，欢迎来到 <strong>mantoujun's Lab</strong>！这里是由学习计算机的用户组建的一个小组织，也是一所小小的学习基地。在这里，我们会互相讨论、互相学习，分享一些实用且有创意的项目、知识等。
        </p>
        <p>
          我们的目标是：<strong class="text-primary">用最小可行方案落地每一个想法</strong>！
        </p>
        <p>
          如果你也有一些新奇的想法，欢迎在我们的 <a class="link link-primary" href={`${org.url}/discussions`} target="_blank" rel="noopener noreferrer">Discussion</a> 中讨论。
        </p>
      </div>
    </section>

    <!-- 我们做什么 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">🛠️ 我们在做什么</h2>
        <ul class="list-disc list-inside space-y-1 opacity-80">
          <li>搭建班级网站、文档与博客，记录学习与生活的点滴。</li>
          <li>动手做小工具：Python、Web 应用……</li>
          <li>分享实用的学习笔记、教程与踩坑记录。</li>
          <li>互相 Review、互相讨论，把想法快速变成可用的东西。</li>
        </ul>
      </div>
    </section>

    <!-- 技术栈 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">🧪 主要语言</h2>
        <div class="flex flex-wrap gap-2">
          {languages.map((lang) => (
            <a
              class="badge badge-outline hover:badge-primary cursor-pointer"
              href={`${org.urlorg}/repositories?language=${encodeURIComponent(lang)}&type=all`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {lang}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 加入我们 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">💬 加入我们</h2>
        <p class="opacity-80">
          无论你是学生、刚入门的新手，还是有经验的老司机，只要对做东西感兴趣，都可以加入进来。一起讨论、一起学习、一起把想法变成可用的项目。
        </p>
        <div class="flex flex-wrap gap-2 mt-2">
          <ContactLink kind="github" variant="btn-primary" />
          <ContactLink kind="discord" />
          <ContactLink kind="gitee" />
          <ContactLink kind="qq" />
          <ContactLink kind="email" />
        </div>
        <p class="text-sm opacity-60 mt-3">
          网站：<a class="link link-hover" href={org.website} target="_blank" rel="noopener noreferrer">{org.website}</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
