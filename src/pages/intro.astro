---
import Layout from '../layouts/Layout.astro';

// GitHub 组织信息（数据硬编码，便于静态构建，无需调用 API）
const org = {
  name: "mantoujun's Lab",
  handle: 'mantoujun-lab',
  url: 'https://github.com/mantoujun-lab',
  urlorg: 'https://github.com/orgs/mantoujun-lab',
  website: 'https://mantoujun-lab.com',
  location: 'China',
  contact: 'contact@mantoujun-lab.com',
  qq: 'https://qm.qq.com/q/Y31MDEbxWE',
  gitee: 'https://gitee.com/mantoujun-lab',
  discord: 'https://discord.gg/hFEYKH3M4',
  avatar: 'https://avatars.githubusercontent.com/u/300905089?s=200&v=4',
};

const languages = ['JavaScript', 'Astro', 'Python', 'TypeScript', 'HTML'];
---

<Layout
  title="关于我们 - 25 级计算机应用 1 班"
  description="我们是 mantoujun's Lab，用最小可行方案落地每一个想法。了解 GitHub 组织 mantoujun-lab 的成员、目标、仓库与社区入口。"
>
  <main class="container mx-auto p-6 md:p-8 max-w-5xl space-y-3">
    <!-- 组织简介 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body flex-row items-center gap-6">
        <div class="avatar">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden">
            <img src={org.avatar} alt={`${org.name} avatar`} loading="lazy" />
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl md:text-3xl font-bold flex flex-wrap items-center gap-2">
            {org.name}
            <span class="badge badge-primary badge-outline align-middle border-green-500 bg-green-100 text-green-500">Verified</span>
          </h1>
          <p class="text-sm opacity-60 mt-1">
            <span class="font-mono">@{org.handle}</span>
            <span class="mx-2">·</span>
            <span>{org.location}</span>
          </p>
          <p class="mt-3 text-base md:text-lg">
            用最小可行方案落地每一个想法。
          </p>
        </div>
        <div class="hidden md:flex flex-col gap-2">
          <a class="btn btn-primary btn-sm" href={org.url} target="_blank" rel="noopener noreferrer">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.234 1.91 1.234 3.22 0 4.61-2.804 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
            访问组织
          </a>
        </div>
      </div>
      <div class="card-body pt-0">
        <div class="md:hidden flex flex-wrap gap-2">
          <a class="btn btn-primary btn-sm flex-1" href={org.url} target="_blank" rel="noopener noreferrer">访问 GitHub 组织</a>
        </div>
      </div>
    </section>

    <!-- 欢迎语 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">👋 欢迎来到 mantoujun's Lab</h2>
        <p>
          你好，欢迎来到 <strong>mantoujun's Lab</strong>！这里是由学习计算机的用户组建的一个小组织，也是一所小小的学习基地。在这里，我们会互相讨论、互相学习，分享一些实用且有创意的项目、知识等。
        </p>
        <p>
          我们的目标是：<strong class="text-primary">用最小可行方案落地每一个想法</strong>！
        </p>
        <p>
          如果你也有一些新奇的想法，欢迎在我们的 <a class="link link-primary" href={`${org.url}/discussions`} target="_blank" rel="noopener noreferrer">Discussion</a> 中讨论。
        </p>
      </div>
    </section>

    <!-- 我们做什么 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">🛠️ 我们在做什么</h2>
        <ul class="list-disc list-inside space-y-1 opacity-80">
          <li>搭建班级网站、文档与博客，记录学习与生活的点滴。</li>
          <li>动手做小工具： Python、Web 应用……</li>
          <li>分享实用的学习笔记、教程与踩坑记录。</li>
          <li>互相 Review、互相讨论 ，把想法快速变成可用的东西。</li>
        </ul>
      </div>
    </section>

    <!-- 技术栈 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">🧪 主要语言</h2>
        <div class="flex flex-wrap gap-2">
          {languages.map((lang) => (
            <a
              class="badge badge-outline hover:badge-primary cursor-pointer"
              href={`${org.urlorg}/repositories?language=${encodeURIComponent(lang)}&type=all`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {lang}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 加入我们 -->
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">💬 加入我们</h2>
        <p class="opacity-80">
          无论你是学生、刚入门的新手，还是有经验的老司机，只要对做东西感兴趣，都可以加入进来。一起讨论、一起学习、一起把想法变成可用的项目。
        </p>
        <div class="flex flex-wrap gap-2 mt-2">
          <a class="btn btn-primary btn-sm" href={org.url} target="_blank" rel="noopener noreferrer">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.234 1.91 1.234 3.22 0 4.61-2.804 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
            GitHub
          </a>
          <a class="btn btn-outline btn-sm" href={org.discord} target="_blank" rel="noopener noreferrer">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M20.317 4.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 0 0-.079.036c-.21.369-.444.85-.608 1.23a18.6 18.6 0 0 0-5.487 0a12 12 0 0 0-.617-1.23A.08.08 0 0 0 8.562 3c-1.714.29-3.354.8-4.885 1.491a.1.1 0 0 0-.032.027C.533 9.093-.32 13.555.099 17.961a.08.08 0 0 0 .031.055a20 20 0 0 0 5.993 2.98a.08.08 0 0 0 .084-.026a14 14 0 0 0 1.226-1.963a.074.074 0 0 0-.041-.104a13 13 0 0 1-1.872-.878a.075.075 0 0 1-.008-.125q.19-.14.372-.287a.08.08 0 0 1 .078-.01c3.927 1.764 8.18 1.764 12.061 0a.08.08 0 0 1 .079.009q.18.148.372.288a.075.075 0 0 1-.006.125q-.895.515-1.873.877a.075.075 0 0 0-.041.105c.36.687.772 1.341 1.225 1.962a.08.08 0 0 0 .084.028a20 20 0 0 0 6.002-2.981a.08.08 0 0 0 .032-.054c.5-5.094-.838-9.52-3.549-13.442a.06.06 0 0 0-.031-.028M8.02 15.278c-1.182 0-2.157-1.069-2.157-2.38c0-1.312.956-2.38 2.157-2.38c1.21 0 2.176 1.077 2.157 2.38c0 1.312-.956 2.38-2.157 2.38m7.975 0c-1.183 0-2.157-1.069-2.157-2.38c0-1.312.955-2.38 2.157-2.38c1.21 0 2.176 1.077 2.157 2.38c0 1.312-.946 2.38-2.157 2.38"/></svg>
			Discord
          </a>
          <a class="btn btn-outline btn-sm" href={org.gitee} target="_blank" rel="noopener noreferrer">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m-1.852 4.444a3.704 3.704 0 0 0-3.704 3.704v6.913c0 .273.222.495.494.495h7.285a3.334 3.334 0 0 0 3.333-3.333v-2.84a.494.494 0 0 0-.495-.494h-5.678a.495.495 0 0 0-.494.494v1.234c0 .273.22.494.493.494h3.458c.272 0 .493.221.493.493v.248a1.48 1.48 0 0 1-1.481 1.481H9.16a.494.494 0 0 1-.494-.493v-4.692c0-.818.663-1.48 1.482-1.481h6.913a.495.495 0 0 0 .494-.494V6.938a.493.493 0 0 0-.494-.494z"/></svg>
			Gitee
          </a>
          <a class="btn btn-outline btn-sm" href={org.qq} target="_blank" rel="noopener noreferrer">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 1024 1024"><path d="M0 0h1024v1024H0z" fill="none"/><path fill="currentColor" d="M824.8 613.2c-16-51.4-34.4-94.6-62.7-165.3C766.5 262.2 689.3 112 511.5 112C331.7 112 256.2 265.2 261 447.9c-28.4 70.8-46.7 113.7-62.7 165.3c-34 109.5-23 154.8-14.6 155.8c18 2.2 70.1-82.4 70.1-82.4c0 49 25.2 112.9 79.8 159c-26.4 8.1-85.7 29.9-71.6 53.8c11.4 19.3 196.2 12.3 249.5 6.3c53.3 6 238.1 13 249.5-6.3c14.1-23.8-45.3-45.7-71.6-53.8c54.6-46.2 79.8-110.1 79.8-159c0 0 52.1 84.6 70.1 82.4c8.5-1.1 19.5-46.4-14.5-155.8"/></svg>
			QQ 群
          </a>
          <a class="btn btn-outline btn-sm" href={`mailto:${org.contact}`}>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M18.75 12a6.75 6.75 0 1 0-3.375 5.846a.75.75 0 0 1 .75 1.299A8.251 8.251 0 1 1 20.25 12a.75.75 0 0 1-1.5 0"/><path fill="currentColor" d="M15.75 13a1.5 1.5 0 0 0 3 0h1.5a3 3 0 0 1-6 0z"/><path fill="currentColor" d="M14.25 12a2.25 2.25 0 1 0-4.5 0a2.25 2.25 0 0 0 4.5 0m1.5 0a3.75 3.75 0 1 1-7.5 0a3.75 3.75 0 0 1 7.5 0m4.5-.75V13h-1.5v-1.75z"/><path fill="currentColor" d="M14.25 14V9a.75.75 0 0 1 1.5 0v5a.75.75 0 0 1-1.5 0"/></svg>
			邮箱
          </a>
        </div>
        <p class="text-sm opacity-60 mt-3">
          网站：<a class="link link-hover" href={org.website} target="_blank" rel="noopener noreferrer">{org.website}</a>
        </p>
      </div>
    </section>
  </main>
</Layout>