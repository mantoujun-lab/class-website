---
// Site footer: link columns + copyright bar + WeChat funding modal.
import Modal from './Modal.astro';
---

<footer class="footer grid-cols-3 p-10 bg-base-200 text-base-content">
	<nav>
		<h6 class="footer-title">关于</h6>
		<a class="link link-hover" href="/about/">班级介绍</a>
		<a class="link link-hover" href="/intro/">关于我们</a>
	</nav>
	<nav>
		<h6 class="footer-title">资源</h6>
		<a class="link link-hover" href="https://github.com/mantoujun-lab/class-website" target="_blank" rel="noopener noreferrer">GitHub 仓库</a>
		<a class="link link-hover" href="https://github.com/mantoujun-lab/class-website/issues" target="_blank" rel="noopener noreferrer">Issue 反馈</a>
	</nav>
	<nav>
		<h6 class="footer-title">支持</h6>
		<button
			type="button"
			class="link link-hover cursor-pointer"
			onclick="document.getElementById('modal_funding').showModal()"
		>
		微信赞赏
		</button>
	</nav>
</footer>
<footer class="footer px-10 py-4 border-t bg-base-200 border-base-300 text-base-content/60">
	<aside class="items-center">
		<p>© 2026 25 级计算机应用 1 班 · <a href="https://github.com/mantoujun-lab/class-website/blob/main/LICENSE" target="_blank">MIT License</a></p>
	</aside>
</footer>

<!-- 微信赞赏码弹窗 -->
<Modal id="modal_funding" title="微信赞赏" widthClass="max-w-sm">
	<div class="flex flex-col items-center py-2">
		<img
			src="/funding_wechat.png"
			alt="微信赞赏"
			class="max-w-full h-auto rounded-lg shadow-md"
			loading="lazy"
		/>
	</div>
</Modal>
