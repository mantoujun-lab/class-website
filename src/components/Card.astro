---
// Single card with title, description and a primary action button.
interface Props {
	title: string;
	description: string;
	actionLabel?: string;
	href?: string;
}
const { title, description, actionLabel = '跳转', href } = Astro.props;
---

<div class="card bg-base-100 shadow">
	<div class="card-body">
		<h3 class="card-title">{title}</h3>
		<p class="opacity-70">{description}</p>
		{href && (
			<div class="card-actions justify-end">
				<a href={href} class="btn btn-primary btn-sm">{actionLabel}</a>
			</div>
		)}
	</div>
</div>
