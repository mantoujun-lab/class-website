{# ============================================================
   胶囊按钮宏（Button / Pill Button）
   ------------------------------------------------------------
   对应设计图：Button - Content Area
     - 尺寸：88 × 28
     - 圆角：胶囊（1000px）
     - 配色：主题色背景 + 白色文字
     - 内部：左侧图标 + 右侧文字
   参数：
     - icon           : Font Awesome 类名（必填，例 "fa-solid fa-play"）
     - label          : 按钮文字（必填）
     - url            : 点击跳转地址（选填，默认为 "#"）
     - btnColor       : 自定义背景色（选填，留空则走主题色 var(--color-primary)）
     - textColor      : 自定义文字色（选填，留空则走 var(--color-white)）
     - btnHover       : 自定义 hover 背景色（选填，未传则保持原背景色不变；想换主题 dark 时仍传 var(--color-primary-dark)）
     - btnBorder      : 自定义边框颜色（选填，留空则走 --border-color-blue）
     - btnBorderHover : 自定义 hover 边框颜色（选填，留空则回落到 btnBorder，再回落则走 --border-color-blue）
     - target         : HTML 原生 target 属性（选填，留空则不写，即默认 _self）
                          常见值：_blank（新窗口，宏会自动追加 rel="noopener" 防 tabnabbing）、
                                  _parent / _top / 任意 frame 名
   用法：
     {% from "macros/button.njk" import button %}
     {{ button("fa-solid fa-play", "Button", "/xxx.html") }}
     {{ button("fa-solid fa-play", "Button", "/xxx.html", btnColor="#abcdef") }}
     {{ button("fa-solid fa-play", "Button", "/xxx.html", btnColor="#abcdef", textColor="#222", btnHover="#123456") }}
     {{ button("fa-solid fa-play", "Button", "/xxx.html", btnBorder="#e03131") }}
     {{ button("fa-solid fa-play", "Button", "/xxx.html", btnColor="#fff0f0", btnBorder="#e03131") }}
     {{ button("fa-brands fa-github", "前往项目", "https://github.com/xxx", target="_blank") }}
   ============================================================ #}

{% macro button(icon, label, url="#", btnColor="", textColor="", btnHover="", btnBorder="", btnBorderHover="", target="") %}
{%- set _hasHover = btnHover -%}
{%- set _bg = ("--btn-bg:" + btnColor + ";") if btnColor else "" -%}
{%- set _fg = ("--btn-fg:" + textColor + ";") if textColor else "" -%}
{%- set _hv = ("--btn-hover:" + btnHover + ";") if btnHover else "" -%}
{%- set _bd = ("--btn-border:" + btnBorder + ";") if btnBorder else "" -%}
{# --- btnBorderHover 兜底：未传则回落到 btnBorder，再未传则留给 scss 默认 --- #}
{%- set _bdhColor = btnBorderHover or btnBorder -%}
{%- set _bdh = ("--btn-border-hover:" + _bdhColor + ";") if _bdhColor else "" -%}
{%- set _style = _bg + _fg + _hv + _bd + _bdh -%}
{# --- target="_blank" 时自动追加 rel="noopener"，防 tabnabbing 安全漏洞 --- #}
{%- set _rel = ' rel="noopener"' if target == "_blank" else "" -%}
<a class="btn-pill" href="{{ url }}" {% if target %}target="{{ target }}"{% endif %}{{ _rel | safe }} {% if _style %}style="{{ _style }}"{% endif %}{% if _hasHover %} data-bhover="1"{% endif %}>
    <i class="{{ icon }} btn-pill-icon"></i>
    <span class="btn-pill-label">{{ label }}</span>
</a>
{% endmacro %}