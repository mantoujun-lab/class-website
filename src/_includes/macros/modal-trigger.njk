{# ============================================================
   模态弹窗触发器宏（Modal Trigger）
   ------------------------------------------------------------
   专门用于触发 popup.njk 渲染出的模态弹窗。与 button.njk 的区别：
     - 本宏默认渲染 <button type="button"> 而非 <a>，避免点击跳到 # 或页面顶部
     - 自动绑定 data-modal-open="<modalId>" 属性，让 popup-modal.js 的事件委托识别
     - 复用 .btn-pill 胶囊按钮样式，保证视觉一致
     - 支持 open / close 两个动作（open 用于打开，close 用于关闭）

   参数：
     - modalId        : 弹窗 id（必填，对应 popup 宏的 modalId）
     - icon           : Font Awesome 类名（必填，例 "fa-solid fa-circle-info"）
     - label          : 按钮文字（必填）
     - action         : "open"（默认）/ "close"，open 触发打开，close 触发关闭
     - btnColor       : 自定义背景色（选填，留空走主题色）
     - textColor      : 自定义文字色（选填）
     - btnHover       : 自定义 hover 背景色（选填）
     - btnBorder      : 自定义边框颜色（选填）
     - btnBorderHover : 自定义 hover 边框颜色（选填）

   用法：
     {% from "macros/modal-trigger.njk" import modalTrigger %}
     {{ modalTrigger("announcement", "fa-solid fa-circle-info", "查看公告") }}
     {{ modalTrigger("confirm-delete", "fa-solid fa-trash", "删除", btnColor="#fa5252", textColor="#fff") }}

   对应的弹窗：
     {% from "macros/popup.njk" import popup %}
     {{ popup("announcement", "公告", "<p>...</p>") }}
   ============================================================ #}

{% macro modalTrigger(modalId, icon, label, action="open", btnColor="", textColor="", btnHover="", btnBorder="", btnBorderHover="") %}
{%- set _hasHover = btnHover -%}
{%- set _bg = ("--btn-bg:" + btnColor + ";") if btnColor else "" -%}
{%- set _fg = ("--btn-fg:" + textColor + ";") if textColor else "" -%}
{%- set _hv = ("--btn-hover:" + btnHover + ";") if btnHover else "" -%}
{%- set _bd = ("--btn-border:" + btnBorder + ";") if btnBorder else "" -%}
{%- set _bdhColor = btnBorderHover or btnBorder -%}
{%- set _bdh = ("--btn-border-hover:" + _bdhColor + ";") if _bdhColor else "" -%}
{%- set _style = _bg + _fg + _hv + _bd + _bdh -%}
{%- set _dataAttr = ("data-modal-open=" + '"' + modalId + '"') if action == "open" else ("data-modal-close=" + '"' + modalId + '"') -%}
<button type="button" class="btn-pill" {{ _dataAttr | safe }} {% if _style %}style="{{ _style }}"{% endif %}{% if _hasHover %} data-bhover="1"{% endif %}>
    <i class="{{ icon }} btn-pill-icon"></i>
    <span class="btn-pill-label">{{ label }}</span>
</button>
{% endmacro %}