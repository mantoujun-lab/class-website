{# ============================================================
卡片宏（Card Macros）
------------------------------------------------------------
提供三种卡片形态：
- card() : 网格中使用的"格子卡片"，默认高度 120px，
受 .card-grid / .cardzone 约束，桌面 3 列 → 平板 2 列 → 手机 1 列。
- cardFull() : 通栏独立卡片，宽度撑满父容器，标题/正文/按钮三层结构
完整保留，与 .card-full-list 配合可纵向堆叠多个。
- cardStandalone() : 独立信息卡片，对应设计稿 Card（图左 icon + 图右 标题/正文），
独立成块使用，无按钮。
内部统一使用 .card-title / .card-content / .card-btn 三层结构，
便于样式复用与扩展。

跳转链接统一用 target 参数（card / cardFull 支持，cardStandalone 无跳转因此不支持）：
  - 留空：不写 target 属性（同 _self，当前 tab 跳转，行为不变）
  - _blank：新窗口打开，宏会自动追加 rel="noopener" 防 tabnabbing
  - _parent / _top / 任意 frame 名：透传给 HTML 原生 target
============================================================ #}

{# --- 内部片段：拼接 background / color inline style -------
仅在传入非空颜色时输出对应声明；未传入则返回空串。
（保留给 cardStandalone 使用） #}
{% macro colorStyle(bgColor="", textColor="") %}
{%- set s = "" -%}
{%- if bgColor %}{%- set s = s + "background-color: " + bgColor + "; " -%}{%- endif -%}
{%- if textColor %}{%- set s = s + "color: " + textColor + "; " -%}{%- endif -%}
{{- s -}}
{% endmacro %}

{# --- 内部片段：拼接卡片级 CSS 变量 -----------------------
仅在传入非空值时输出对应变量；未传入则不输出。
- hoverBorderColor 未传时回落到 borderColor
- hoverBgColor 未传时不输出变量，由 scss fallback 处理 #}
{% macro cardStyle(bgColor="", textColor="", borderColor="", hoverBgColor="", hoverBorderColor="") %}
{%- set _bg = ("--card-bg:" + bgColor + ";") if bgColor else "" -%}
{%- set _fg = ("--card-fg:" + textColor + ";") if textColor else "" -%}
{%- set _bd = ("--card-border:" + borderColor + ";") if borderColor else "" -%}
{%- set _bgh = ("--card-bg-hover:" + hoverBgColor + ";") if hoverBgColor else "" -%}
{# --- hoverBorderColor 兜底：未传则回落到 borderColor --- #}
{%- set _bdhColor = hoverBorderColor or borderColor -%}
{%- set _bdh = ("--card-border-hover:" + _bdhColor + ";") if _bdhColor else "" -%}
{%- set _style = _bg + _fg + _bd + _bgh + _bdh -%}
{{- _style -}}
{% endmacro %}

{# --- 内部片段：拼接按钮级 CSS 变量 -----------------------
仅在传入非空值时输出对应变量；未传入则不输出。
- btnBorderHover 未传时回落到 btnBorder #}
{% macro btnStyle(btnColor="", btnTextColor="", btnHover="", btnBorder="", btnBorderHover="") %}
{%- set _bg = ("--btn-bg:" + btnColor + ";") if btnColor else "" -%}
{%- set _fg = ("--btn-fg:" + btnTextColor + ";") if btnTextColor else "" -%}
{%- set _hv = ("--btn-hover:" + btnHover + ";") if btnHover else "" -%}
{%- set _bd = ("--btn-border:" + btnBorder + ";") if btnBorder else "" -%}
{# --- btnBorderHover 兜底：未传则回落到 btnBorder --- #}
{%- set _bdhColor = btnBorderHover or btnBorder -%}
{%- set _bdh = ("--btn-border-hover:" + _bdhColor + ";") if _bdhColor else "" -%}
{%- set _style = _bg + _fg + _hv + _bd + _bdh -%}
{{- _style -}}
{% endmacro %}

{# --- 内部通用片段：拼接标题 / 内容 / 按钮 ----------------- #}
{% macro cardBody(title, content, url="", btnText="查看", btnStyleAttr="", target="") %}
<div class="card-title">{{ title }}</div>
<div class="card-content">{{ content }}</div>
{# --- target="_blank" 时自动追加 rel="noopener"，防 tabnabbing 安全漏洞 --- #}
{%- set _rel = ' rel="noopener"' if target == "_blank" else "" -%}
<a class="card-btn" href="{{ url }}"{% if target %} target="{{ target }}"{% endif %}{{ _rel | safe }} {% if btnStyleAttr %}style="{{ btnStyleAttr }}"{% endif %}>{{ btnText }}</a>
{% endmacro %}

{# --- 内部公共卡片渲染逻辑（card 和 cardFull 共用） -------
通过 className 参数区分卡片类型，避免代码重复 #}
{% macro _cardBase(className, title, content, url, btnText, bgColor, textColor, borderColor, hoverBgColor, hoverBorderColor, btnColor, btnTextColor, btnHover, btnBorder, btnBorderHover, target) %}
{%- set _hasCardCustom = (bgColor or textColor or borderColor or hoverBgColor or hoverBorderColor) -%}
{%- set _hasBtnCustom = (btnColor or btnTextColor or btnHover or btnBorder or btnBorderHover) -%}
{%- set _cardStyle = cardStyle(bgColor, textColor, borderColor, hoverBgColor, hoverBorderColor) if _hasCardCustom else "" -%}
{%- set _btnStyle = btnStyle(btnColor, btnTextColor, btnHover, btnBorder, btnBorderHover) if _hasBtnCustom else "" -%}
<div class="{{ className }}" {% if _cardStyle %}style="{{ _cardStyle }}"{% endif %}>
    {{ cardBody(title, content, url, btnText, _btnStyle, target) }}
</div>
{% endmacro %}

{# --- 网格中的"格子卡片"（当前即三列卡片） -------------
可选参数：
- bgColor : 背景色（如 "#f5f5f5" 或 "var(--xxx)"），默认空 → 走默认样式
- textColor : 文本色，默认空 → 走默认样式
- borderColor : 卡片边框色，默认空 → 走默认样式
- hoverBgColor : hover 背景色，默认空 → 保持原背景色
- hoverBorderColor : hover 边框色，默认空 → 回落到 borderColor
- btnColor : 按钮背景色，默认空 → 走默认样式
- btnTextColor : 按钮文字色，默认空 → 走默认样式
- btnHover : 按钮 hover 背景色，默认空 → 走默认样式
- btnBorder : 按钮边框色，默认空 → 走默认样式
- btnBorderHover : 按钮 hover 边框色，默认空 → 回落到 btnBorder
- target  : HTML 原生 target 属性（选填），传给卡片内 .card-btn <a> 链接
             常见值：_blank（新窗口，自动追加 rel="noopener" 防 tabnabbing）、
                     _parent / _top / 任意 frame 名 #}
{% macro card(title, content, url="", btnText="查看", bgColor="", textColor="", borderColor="", hoverBgColor="", hoverBorderColor="", btnColor="", btnTextColor="", btnHover="", btnBorder="", btnBorderHover="", target="") %}
{{- _cardBase("three-column-card", title, content, url, btnText, bgColor, textColor, borderColor, hoverBgColor, hoverBorderColor, btnColor, btnTextColor, btnHover, btnBorder, btnBorderHover, target) -}}
{% endmacro %}

{# --- 通栏独立卡片（占满整列） --------------------------
可选参数同 card() #}
{% macro cardFull(title, content, url="", btnText="查看", bgColor="", textColor="", borderColor="", hoverBgColor="", hoverBorderColor="", btnColor="", btnTextColor="", btnHover="", btnBorder="", btnBorderHover="", target="") %}
{{- _cardBase("card-full", title, content, url, btnText, bgColor, textColor, borderColor, hoverBgColor, hoverBorderColor, btnColor, btnTextColor, btnHover, btnBorder, btnBorderHover, target) -}}
{% endmacro %}

{# --- 独立信息卡片（对应设计稿 Card） ------------------
参数：
- icon : Font Awesome 类名（必填，例 "fa-solid fa-circle-info"）
- title : 标题文字（必填）
- content : 正文文字（必填）
- bgColor : 背景色，可选
- textColor : 文本色，可选
用法：
{{ cardStandalone("fa-solid fa-circle-info", "Title", "Body text...") }}
{{ cardStandalone("fa-solid fa-circle-info", "Title", "Body", bgColor="#fffbe6", textColor="#5a4a00") }}
{{ cardStandalone("fa-solid fa-handshake", "Title", "Body", grid=true) }} #}
{% macro cardStandalone(icon, title, content, bgColor="", textColor="", grid=false) %}
{%- set _style = colorStyle(bgColor, textColor) -%}
{%- set _class = "card-standalone" + (" card-standalone-grid" if grid) -%}
<div class="{{ _class }}" {% if _style %}style="{{ _style }}" {% endif %}>
    <div class="card-info">
        <i class="{{ icon }} card-info-icon"></i>
    </div>
    <div class="card-body">
        <div class="card-title">{{ title }}</div>
        <div class="card-content">{{ content }}</div>
    </div>
</div>
{% endmacro %}

{# --- 文章 / 事件专属卡片（含日期 + 作者） --------------------
参数：
- title       : 标题（必填）
- content     : 描述正文（必填）
- url         : 跳转链接（选填）
- btnText     : 按钮文字，默认 "查看详细信息"
- date        : 发布日期（选填，传入后会在元信息行渲染，只显示 yyyy-MM-dd）
- author      : 作者名（选填，传入后显示 "作者：XXX"）
- bgColor / textColor / borderColor / hoverBgColor / hoverBorderColor : 卡片级自定义颜色（选填）
- btnColor / btnTextColor / btnHover / btnBorder / btnBorderHover     : 按钮级自定义颜色（选填）
- target      : HTML 原生 target 属性（选填，_blank 自动追加 rel="noopener"）
用法：
{{ cardEntry(entry.data.title, entry.data.description or "", entry.url | url, "查看详细信息", entry.data.date, entry.data.author) }}
#}
{% macro cardEntry(title, content, url="", btnText="查看详细信息", date="", author="", bgColor="", textColor="", borderColor="", hoverBgColor="", hoverBorderColor="", btnColor="", btnTextColor="", btnHover="", btnBorder="", btnBorderHover="", target="") %}
{%- set _hasCardCustom = (bgColor or textColor or borderColor or hoverBgColor or hoverBorderColor) -%}
{%- set _hasBtnCustom = (btnColor or btnTextColor or btnHover or btnBorder or btnBorderHover) -%}
{%- set _cardStyle = cardStyle(bgColor, textColor, borderColor, hoverBgColor, hoverBorderColor) if _hasCardCustom else "" -%}
{%- set _btnStyle = btnStyle(btnColor, btnTextColor, btnHover, btnBorder, btnBorderHover) if _hasBtnCustom else "" -%}
{%- set _rel = ' rel="noopener"' if target == "_blank" else "" -%}
{%- set _dateStr = "" -%}
{%- if date -%}
    {%- set _dateStr = date | bjDateOnly -%}
{%- endif -%}
<div class="card-entry" {% if _cardStyle %}style="{{ _cardStyle }}"{% endif %}>
    <a class="card-entry-title" href="{{ url }}"{% if target %} target="{{ target }}"{% endif %}{{ _rel | safe }}>{{ title }}</a>
    {%- if _dateStr or author %}
    <div class="card-entry-meta">
        {%- if _dateStr %}
        <span>{{ _dateStr }}</span>
        {%- endif %}
        {%- if author %}
        <span>作者：{{ author }}</span>
        {%- endif %}
    </div>
    {%- endif %}
    <div class="card-entry-content">{{ content }}</div>
    <a class="card-entry-btn" href="{{ url }}"{% if target %} target="{{ target }}"{% endif %}{{ _rel | safe }} {% if _btnStyle %}style="{{ _btnStyle }}"{% endif %}>{{ btnText }}</a>
</div>
{% endmacro %}
