{# ============================================================
   导航栏组件（Header Component）
   ------------------------------------------------------------
   header 整体背景色支持页面级自定义（按优先级从高到低）：
   1. njk 模板：在调用 header 的 layout 中通过 `{% set headerBg = ... %}` 设定
      （Nunjucks set 是在 include header 之前求值，因此会覆盖下方 front matter）
   2. md front matter：定义 `headerBg: "#ff0000"`（次高优先级）
   3. 不设置则使用主题色（由 --color-primary 提供，跟随深浅色主题）

   i18n：
   - 所有展示文案通过 `{{ 'nav.xxx' | i18n }}` 读取
   - 所有站内链接通过 `{{ '/xxx' | localUrl }}` 自动加 locale 前缀
   - 语言切换器：根据当前 locale 自动列出可用语言、跳到对应首页
   ============================================================ #}
{%- set _headerBg = headerBg or "" -%}
{%- set _headerStyle = ("--header-bg:" + _headerBg + ";") if _headerBg else "" -%}
{%- if _headerStyle -%}
<header style="{{ _headerStyle }}">
{%- else -%}
<header>
{%- endif -%}
    <input type="checkbox" id="nav-toggle" hidden>
    <div class="nav-title"><a href="{{ '/' | localUrl }}"><i class="fa-solid fa-school" aria-hidden="true"></i></a></div>
    <label for="nav-toggle" class="nav-hamburger"><i class="fa-solid fa-bars" aria-hidden="true"></i></label>
    <nav>
        <button type="button" class="nav-drawer-close" aria-label="{{ 'common.close' | i18n }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        <div class="nav-btns">
            <a href="{{ '/' | localUrl }}"><i class="fa-solid fa-house" aria-hidden="true"></i><span class="hover-show">{{ 'nav.home' | i18n }}</span></a>
            <a href="{{ '/article/' | localUrl }}"><i class="fa-solid fa-book" aria-hidden="true"></i><span class="hover-show">{{ 'nav.article' | i18n }}</span></a>
            <a href="{{ '/wiki/' | localUrl }}"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span class="hover-show">{{ 'nav.wiki' | i18n }}</span></a>
            <a href="{{ '/zone/' | localUrl }}"><i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i><span class="hover-show">{{ 'nav.zone' | i18n }}</span></a>
            <a href="https://github.com/mantoujun-lab/class-website" target="_blank"><i class="fa-brands fa-github" aria-hidden="true"></i><span class="hover-show">{{ 'nav.github' | i18n }}</span></a>
            <a href="https://hjx-25pc1.github.io/astro/"><i class="fa-solid fa-rocket" aria-hidden="true"></i><span class="hover-show">{{ 'nav.astro' | i18n }}</span></a>
            <a href="#" class="nav-popup-btn" aria-haspopup="true" aria-expanded="false" aria-controls="nav-popup" aria-label="{{ 'nav.siteMap' | i18n }}" role="button"><i class="fa-solid fa-sitemap" aria-hidden="true"></i><span class="hover-show">{{ 'nav.siteMap' | i18n }}</span></a>

            {# 设置按钮 #}
            <button type="button" class="nav-settings-btn" data-modal-open="settings" aria-label="{{ 'settings.title' | i18n }}">
                <i class="fa-solid fa-gear" aria-hidden="true"></i><span class="hover-show">{{ 'settings.title' | i18n }}</span>
            </button>
        </div>
    </nav>
    <div class="nav-popup" id="nav-popup" role="dialog" aria-modal="true" aria-label="{{ 'nav.siteMap' | i18n }}">
        <button type="button" class="nav-popup-close" aria-label="{{ 'common.close' | i18n }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        {% include "components/nav.njk" %}
    </div>
    {# 统一遮罩：弹窗与抽屉共享，由 JS 按优先级关闭 #}
    <div class="overlay"></div>
    {% include "components/settings-panel.njk" %}
</header>
