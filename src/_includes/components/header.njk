{# ============================================================
   导航栏组件（Header Component）
   ------------------------------------------------------------
   header 整体背景色支持页面级自定义（按优先级从高到低）：
   1. md front matter：定义 `headerBg: "#ff0000"`
   2. njk 模板：在调用 header 的 layout 中通过 set 设定 `headerBg`
   3. 不设置则使用主题色（由 --color-primary 提供，跟随深浅色主题）
   实现原理：
   - header.scss 中 background 使用 var(--header-bg, $color-primary)
   - 此处仅当 headerBg 非空时输出 inline style，避免给默认卡片加多余的空 style

   按钮 hover / 移动端背景色不在此处暴露，按钮颜色统一走
   `_theme-vars.scss` 中全局声明的 5 个 CSS 变量：
   --header-hover-bg / --nav-drawer-close-hover-bg /
   --nav-mobile-btn-bg / --nav-mobile-btn-border /
   --nav-mobile-btn-hover-bg
   默认值用 color-mix 跟随 --header-bg 自动给出协调的对比色。
   ============================================================ #}
{%- set _headerBg = headerBg or "" -%}
{%- set _headerStyle = ("--header-bg:" + _headerBg + ";") if _headerBg else "" -%}
{%- if _headerStyle -%}
<header style="{{ _headerStyle }}">
{%- else -%}
<header>
{%- endif -%}
    <input type="checkbox" id="nav-toggle" hidden>
    <div class="nav-title"><a href="/"><i class="fa-solid fa-school" aria-hidden="true"></i></a></div>
    <label for="nav-toggle" class="nav-hamburger"><i class="fa-solid fa-bars" aria-hidden="true"></i></label>
    <nav>
        <button type="button" class="nav-drawer-close" aria-label="关闭导航菜单"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        <div class="nav-btns">
            <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i><span class="hover-show">首页</span></a>
            <a href="/article.html"><i class="fa-solid fa-book" aria-hidden="true"></i><span class="hover-show">文章</span></a>
            <a href="/wiki.html"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span class="hover-show">Wiki</span></a>
            <a href="/zone.html"><i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i><span class="hover-show">分区</span></a>
            <a href="https://github.com/hjx-25pc1/hjx-25pc1.github.io" target="_blank"><i class="fa-brands fa-github" aria-hidden="true"></i><span class="hover-show">此 Github 项目</span></a>
            <a href="/astro"><i class="fa-solid fa-rocket" aria-hidden="true"></i><span class="hover-show">Astro Playground</span></a>
            <a href="#" class="nav-popup-btn" aria-haspopup="true" aria-expanded="false" aria-controls="nav-popup" aria-label="站点导航" role="button"><i class="fa-solid fa-sitemap" aria-hidden="true"></i><span class="hover-show">导航</span></a>
            <div class="theme-switcher">
                <button type="button" class="theme-btn" aria-label="切换主题" aria-haspopup="true" aria-expanded="false">
                    <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i><span class="hover-show">切换主题</span>
                </button>
                <ul class="theme-menu" role="menu">
                    <li role="none">
                        <button type="button" role="menuitem" data-theme-value="auto">
                            <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i> 跟随系统
                        </button>
                    </li>
                    <li role="none">
                        <button type="button" role="menuitem" data-theme-value="light">
                            <i class="fa-solid fa-sun" aria-hidden="true"></i> 浅色
                        </button>
                    </li>
                    <li role="none">
                        <button type="button" role="menuitem" data-theme-value="dark">
                            <i class="fa-solid fa-moon" aria-hidden="true"></i> 深色
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="nav-popup" id="nav-popup" role="dialog" aria-modal="true" aria-label="站点导航菜单">
        <button type="button" class="nav-popup-close" aria-label="关闭导航菜单"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        {% include "components/nav.njk" %}
    </div>
    {# 统一遮罩：弹窗与抽屉共享，由 JS 按优先级关闭 #}
    <div class="overlay"></div>
</header>