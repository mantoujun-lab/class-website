<!DOCTYPE html>
<html lang="{{ lang or 'zh-CN' }}" dir="{{ dir or 'ltr' }}">

<head>
    {%- set layoutIcon = "/assets/images/icon/home.png" %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or ('common.page' | i18n) }}</title>
    {% include "components/head-assets.njk" %}
</head>

<body>
    {% from "macros/button.njk" import button %}
    {% include "../components/header.njk" %}

    {# ==================== Hero 横幅 ==================== #}
    <section class="hero-banner">
        <div class="hero-inner">
            <div class="hero-tag"><i class="fa-solid fa-graduation-cap"></i> {{ 'home.heroTag' | i18n }}</div>
            <h1 class="hero-title">
                {{ 'home.heroTitle1' | i18n }}<br>
                <span class="hero-title-accent">{{ 'home.heroTitle2' | i18n }}</span>
            </h1>
            <p class="hero-subtitle">
                {{ 'home.heroSubtitle1' | i18n }}<br>
                {{ 'home.heroSubtitle2' | i18n }}
            </p>
            <div class="hero-actions">
                {{ button("fa-solid fa-book-open", ('home.btnGetStarted' | i18n), ('/wiki/getting-started/' | localUrl)) }}
                {{ button("fa-brands fa-github", ('home.btnRepo' | i18n), "https://github.com/hjx-25pc1/hjx-25pc1.github.io", target="_blank") }}
                {{ button("fa-solid fa-rocket", ('home.btnAstro' | i18n), ('/astro' | localUrl), btnColor="rgb(255, 150, 0)", btnHover="rgb(200, 150, 0)", btnBorder="rgb(200, 150, 0)") }}
            </div>

            {# 统计数字 + 浏览量图片（more counter 保留,作为附加信息） #}
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-num">37</div>
                    <div class="hero-stat-label">{{ 'home.stat.students' | i18n }}</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num">2</div>
                    <div class="hero-stat-label">{{ 'home.stat.maintainers' | i18n }}</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num">5</div>
                    <div class="hero-stat-label">{{ 'home.stat.zones' | i18n }}</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num hero-stat-num--text">Eleventy</div>
                    <div class="hero-stat-label">{{ 'home.stat.stack' | i18n }}</div>
                </div>
                <div class="hero-stat hero-stat--counter">
                    <img src="https://count.getloli.com/@hjx-25pc1.github.io?name=hjx-25pc1.github.io&theme=3d-num&padding=7&offset=0&align=top&scale=1&pixelated=1&darkmode=auto" alt="{{ 'home.stat.views' | i18n }}" class="hero-counter-img">
                    <div class="hero-stat-label">{{ 'home.stat.views' | i18n }}</div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== 关于我们（article 块） ==================== #}
    <article>
        <h2>{{ 'home.aboutTitle' | i18n }}</h2>
        <div align="center">
            <p>{{ 'home.aboutP1' | i18n }}</p>
            <p>{{ 'home.aboutP2' | i18n }}</p>
            <p>{{ 'home.aboutP3' | i18n }}</p>
            {{ button("fa-solid fa-arrow-right", ('home.btnLearnMore' | i18n), ('/about/' | localUrl), btnColor="rgba(200, 255, 200)", textColor="rgb(0, 0, 0)", btnHover="rgb(150, 200, 150)", btnBorder="rgb(150, 200, 150)") }}
        </div>
    </article>

    {# ==================== 主体内容（由 index.md 注入） ==================== #}
    <article>
        {{ content | safe }}
    </article>

    {# ==================== 友情链接 ==================== #}
    <article>
        <h2>{{ 'home.friendsTitle' | i18n }}</h2>
        <div align="center">
            {{ button("fa-solid fa-smile", "mantoujun12", "https://mantoujun12.github.io", btnColor="rgb(255, 255, 255)", btnHover="rgb(200, 200, 200)", textColor="rgb(0, 0, 0)", btnBorder="rgb(200, 200, 200)", target="_blank") }}
            {{ button("fa-solid fa-school", "hnjjx.com", "http://www.hnjjx.com", btnColor="rgb(255, 150, 0)", btnHover="rgb(200, 150, 0)", btnBorder="rgb(200, 150, 0)", target="_blank") }}
        </div>
    </article>
    {% include "components/footer.njk" %}
    <script type="module" src="{{ '/script/main.js' | url }}"></script>
</body>

</html>