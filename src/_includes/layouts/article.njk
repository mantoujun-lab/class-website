<!DOCTYPE html>
<html lang="{{ lang or 'zh-CN' }}" dir="{{ dir or 'ltr' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or ('common.page' | i18n) }}</title>
    {% include "components/head-assets.njk" %}
</head>

<body>
    {% include "../components/header.njk" %}
    <article>
        <h1>{{ title or ('article.listTitle' | i18n) }}</h1>
        {% if author %}
        <p class="author"><i class="fa-solid fa-user"></i> {{ author }}</p>
        {% endif %}
        {% if date %}
        <p class="author"><i class="fa-solid fa-calendar"></i> {{ date | bjDate }}</p>
        {% endif %}
        {%- if description %}
        <p class="wiki-description">{{ description }}</p>
        {%- endif %}
        {{ content | safe }}
    </article>
    {% include "components/footer.njk" %}
    <script type="module" src="{{ '/script/main.js' | url }}"></script>
</body>

</html>
