<!DOCTYPE html>
<html lang="{{ lang or 'zh-CN' }}" dir="{{ dir or 'ltr' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or ('common.page' | i18n) }}</title>
    {% include "components/head-assets.njk" %}
</head>

<body>
    {% include "../components/header.njk" %}

    <button class="wiki-sidebar-toggle" type="button" aria-label="{{ 'wiki.toggleSidebar' | i18n }}" aria-expanded="true">
        <span class="wiki-sidebar-toggle-icon"></span>
    </button>

    <div class="wiki-layout">
        <aside class="wiki-sidebar">
            <h3 class="wiki-sidebar-title">{{ 'wiki.title' | i18n }}</h3>
            <nav class="wiki-nav">
                <ul>
                    <li><a href="{{ '/wiki/' | localUrl }}"
                            class="wiki-nav-home {%- if page.url == ('/' ~ (locale or 'zh-cn') ~ '/wiki/') %} active{% endif %}">{{ 'wiki.all' | i18n }}</a></li>
                </ul>

                {#- 独立导航：基于按 locale 隔离的 wikiByCategory 集合 -#}
                {%- for group in collections['wikiByCategory_' + (locale or 'zh-cn')] %}
                <div class="wiki-nav-group" data-category="{{ group.name }}">
                    <h4 class="wiki-nav-group-title">{{ group.label }}</h4>
                    <ul class="wiki-nav-group-list">
                        {%- for entry in group.pages %}
                        <li>
                            <a href="{{ entry.url | url }}" {%- if entry.url==page.url %} class="active" {% endif %}>
                                {{ entry.data.title }}
                            </a>
                        </li>
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
            </nav>
        </aside>
        <main class="wiki-content wiki-article">
            {%- if description %}
            <p class="wiki-description">{{ description }}</p>
            {%- endif %}
            {{ content | safe }}
            <hr>
            <p class="wiki-edit-link">
                <a href="https://github.com/mantoujun-lab/class-website/edit/main/src/{{ (page.url.split('/')[1] or 'zh-cn') }}/wiki/{{ page.fileSlug }}.md"
                    target="_blank" rel="noopener">
                    {{ 'wiki.editOnGithub' | i18n }}
                </a>
            </p>
        </main>
    </div>

    {% include "components/footer.njk" %}
    <script type="module" src="{{ '/script/main.js' | url }}"></script>
</body>

</html>

{# wiki 侧边栏逻辑已并入 main.js，由 type="module" 入口统一加载 #}
